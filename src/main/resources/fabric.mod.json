{
	"schemaVersion": 1,
	"id": "hotbar-utils",
	"version": "${version}",
	"name": "Hotbar Utils",
	"description": "A simple and configurable mod for previewing and swapping items from the inventory to hotbar.",
	"authors": [
		"_paxq!"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/paxq/hotbar-utils-1.21.11"
	},
	"license": "CC0-1.0",
	"icon": "assets/hotbar-utils/icon.png",
	"environment": "client",
	"entrypoints": {
		"main": [
			"net.paxquinn.hotbar_utils.HotbarUtils"
		],
		"client": [
			"net.paxquinn.hotbar_utils.HotbarUtilsClient"
		],
		"modmenu": [
			"net.paxquinn.hotbar_utils.compat.HotbarUtilsModMenu"
		]
	},
	"mixins": [
		"hotbar-utils.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.18.4",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*",
		"fabric-key-binding-api-v1": "*"
	}
}